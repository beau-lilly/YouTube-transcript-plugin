{
  "manifest_version": 3,
  "name": "YouTube Transcript",
  "short_name": "YT Transcript",
  "version": "1.0.0",
  "description": "Show, search, copy, and download the transcript of the YouTube video in the open tab.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Show transcript",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "src/core.js",
        "src/fetcher.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
